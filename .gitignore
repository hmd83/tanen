# --- Secrets — never commit --------------------------------------------------
prj_credentials.conf
*.pem
*.key
*.pw

# --- Build output ------------------------------------------------------------
build*/
twister-out*/
*.hex
*.bin
*.elf
*.map

# --- Logs / scratch ----------------------------------------------------------
*.log

# --- KiCad -------------------------------------------------------------------
# Lock files, autosave, backups, and per-user local state.
# Gerbers ARE committed on purpose — they are the fabricated artifact.
*.lck
~*.lck
*.kicad_prl
*-backups/
_autosave-*
*.bak
fp-info-cache

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store

# --- Claude Code -------------------------------------------------------------
# Per-machine permission state
.claude/settings.local.json

# --- Handbuch ----------------------------------------------------------------
# Die HTML-Fassung ist die versionierte; das PDF baut scripts/build_manual_pdf.py
# bei Bedarf mit --pdf.
docs/BENUTZERHANDBUCH.pdf

# --- Python ------------------------------------------------------------------
# Byte-code from the analysis scripts under docs/
__pycache__/
*.pyc

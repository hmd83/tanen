mainmenu "TanenBase"

source "Kconfig.zephyr"

config TANENBASE_VERSION
	string "Firmware version (semver, no leading v)"
	default "1.0.0"
	help
	  Printed as the first line of the boot log, which is the first thing
	  anyone reads from a field unit — so it must name the release that is
	  actually flashed. The only copy of the version in the firmware; bump
	  it in the release commit together with the CHANGELOG heading and the
	  git tag. src/ must not carry a version literal of its own (that is how
	  1.0.0 shipped printing v0.3.0).

config TANENBASE_DEV_EUI
	string "LoRaWAN DevEUI (16 hex chars, MSB first)"
	default ""
	help
	  Fixed DevEUI override. Leave empty (default) to derive a unique
	  per-device DevEUI from the SoC factory hardware ID at first boot.
	  A ZMS-stored or BLE-provisioned DevEUI always takes precedence.

config TANENBASE_JOIN_EUI
	string "LoRaWAN JoinEUI (16 hex chars)"
	default "0000000000000000"

config TANENBASE_APP_KEY
	string "LoRaWAN AppKey (32 hex chars) — keep in prj_credentials.conf, never commit"
	default "00000000000000000000000000000000"

config TANENBASE_LORA_ABP
	bool "Activate by personalisation (ABP) instead of OTAA"
	help
	  Seeds the activation mode of a unit whose ZMS holds none; the
	  setup page's Network tab overrides it. ABP sends from the first
	  wake with a fixed DevAddr and session keys and never needs a
	  downlink — for sites where JoinAccepts do not get through.
	  Register the device in TTN as ABP, MAC v1.0.3 (docs/LORAWAN.md §13).

config TANENBASE_DEV_ADDR
	string "ABP DevAddr (8 hex chars, MSB first as TTN prints it)"
	default "00000000"

config TANENBASE_NWK_SKEY
	string "ABP NwkSKey (32 hex chars) — keep in prj_credentials.conf, never commit"
	default "00000000000000000000000000000000"

config TANENBASE_APP_SKEY
	string "ABP AppSKey (32 hex chars) — keep in prj_credentials.conf, never commit"
	default "00000000000000000000000000000000"

config TANENBASE_DEBUG_LOOP_INTERVAL
	int "Debug loop delay when System OFF is skipped (seconds)"
	default 180
	help
	  Minimum delay between cycles when ms_interval=0 (debug mode).
	  Must respect EU868 1% duty cycle at DR_0. Default 180s.

config TANENBASE_BLE_CONFIG
	bool "BLE GATT configuration service"
	default y

config TANENBASE_EXT_SENSORS
	bool "Extended Mode: SwitchBot BLE temperature/humidity sensors"
	default y
	depends on BT
	select BT_OBSERVER
	help
	  Up to 3 SwitchBot Outdoor Meters (max 2 in-hive, max 1 outside),
	  configured from the web setup page. Scanned only on wakes that
	  transmit; each sensor heard adds a 5-byte block to the uplink
	  (see transmit.h).

config TANENBASE_EXT_SCAN_TIMEOUT_MS
	int "Extended Mode scan timeout (milliseconds)"
	default 8000
	depends on TANENBASE_EXT_SENSORS
	help
	  Upper bound on the BLE scan of a transmitting wake. The scan ends
	  earlier as soon as every enabled sensor has sent temperature and
	  battery; a dead sensor costs the full timeout of radio RX.

config TANENBASE_ANOMALY
	bool "Anomaly detection (delta reporting)"
	default y

config TANENBASE_SETUP_TIMEOUT
	int "SETUP state timeout (seconds)"
	default 180

config TANENBASE_DEFAULT_TX_INTERVAL
	int "Default TX/heartbeat interval (seconds)"
	default 14400
	help
	  Mandatory heartbeat TX every N seconds. Default 14400 (4 hours).

config TANENBASE_DEFAULT_MS_INTERVAL
	int "Default measurement interval (seconds)"
	default 300
	help
	  Wake and measure every N seconds. Default 300 (5 minutes).
	  Minimum enforced: 60s.

config TANENBASE_TEMPCOMP
	bool "Load-cell temperature compensation"
	default y
	help
	  Correct the thermal drift of the load cell: a first-order lag filter
	  on the probe temperature plus one gain constant. Measured on the
	  reference unit: 350 g peak-to-peak on a constant 22 kg load over a
	  17.5 K daily cycle, down to sigma = 15.7 g compensated. Full report in
	  docs/load_cells/H40A-C3-0150/README.md.

	  Which constants it runs with is picked at RUNTIME from the load-cell
	  profile (setup page), not built in — one image serves every cell. This
	  switch only decides whether the correction is compiled at all.

config TANENBASE_LC_DEFAULT_PROFILE
	int "Default load-cell profile (0=generic 1=H40A-C3-0150 2=SBS-PF-150 3=custom)"
	default 1
	range 0 3
	help
	  Profile a unit runs until the setup page stores one. Must match
	  LC_PROFILE_* in src/config/config.h. 0 (generic) applies no correction,
	  3 (custom) uses the two constants below. See docs/load_cells/README.md.

config TANENBASE_TEMPCOMP_GAIN_MG_PER_K
	int "Custom-profile compensation gain (milligram per kelvin)"
	default 17734
	help
	  Gain of the CUSTOM profile: added to the raw weight per kelvin of
	  filtered temperature above T_ref. 17734 = +17.734 g/K, fitted on the
	  reference H40A cell and kept here as the starting point for a frame
	  that gets re-characterised.
	  THIS IS A PROPERTY OF THE CELL PLUS ITS MOUNT, not of any one cell
	  model — re-characterise after any mechanical change to the frame. Set
	  to 0 to keep the filter running (t_eff is logged) but apply no
	  correction. The setup page overrides this per unit.

config TANENBASE_TEMPCOMP_TAU_S
	int "Custom-profile thermal lag time constant (seconds)"
	default 1500
	help
	  Time constant of the low-pass filter on the probe temperature, which
	  models the lag between the probe and the cell body. 1500 = 25 min,
	  found by sweeping tau; the optimum is broad (15-40 min all within 1 g)
	  so it does not need tuning per unit — every built-in profile carries
	  the same value. Only matters while the probe is not bonded to the cell
	  body.

config TANENBASE_TEMPCOMP_T_REF_MDEG
	int "Fallback reference temperature (milli-Celsius)"
	default 25000
	help
	  T_ref used until the scale is tared — a tare stores the temperature it
	  ran at and that becomes T_ref from then on. 25000 = 25.000 C, the
	  anchor the coefficient was fitted at.

config TANENBASE_DEFAULT_WEIGHT_THRESHOLD
	int "Default weight anomaly threshold (grams)"
	default 2000

config TANENBASE_DEFAULT_TEMP_THRESHOLD
	int "Default temp anomaly threshold (centi-Celsius)"
	default 500
	help
	  500 = 5.00 degrees C.

# config.c seeds the tare temperature from this even with compensation off.
# TANENBASE_TEMPCOMP itself stays undefined here: measure.c only tests it with
# IS_ENABLED(), so the test app measures uncompensated and needs no tempcomp.c.
config TANENBASE_TEMPCOMP_T_REF_MDEG
	int
	default 25000

# The load-cell profile table lives in config.c, so these are needed even
# though nothing here consumes the correction.
config TANENBASE_LC_DEFAULT_PROFILE
	int
	default 1

config TANENBASE_TEMPCOMP_GAIN_MG_PER_K
	int
	default 17734

config TANENBASE_TEMPCOMP_TAU_S
	int
	default 1500

config TANENBASE_TEST_INTERVAL_S
	int "Measure loop interval (seconds)"
	default 5
	help
	  Delay between measurement cycles in the test app.

# LoRaWAN credentials — copy to prj_credentials.conf and fill in.
#
#   Copy-Item prj_credentials.conf.example prj_credentials.conf
#
# prj_credentials.conf is gitignored. NEVER commit real keys, and never paste
# them into issues or logs.
#
# These values only seed the very first boot. A DevEUI/JoinEUI/AppKey stored in
# ZMS — set over BLE during provisioning — always takes precedence.

# DevEUI (16 hex chars, MSB first).
# Leave EMPTY to derive a unique per-device DevEUI from the SoC's factory
# hardware ID. Recommended: every physical unit needs its own DevEUI, and a
# hardcoded one shared across a batch guarantees a join collision.
CONFIG_TANENBASE_DEV_EUI=""

# JoinEUI / AppEUI (16 hex chars). All-zero is valid on The Things Network.
CONFIG_TANENBASE_JOIN_EUI="0000000000000000"

# AppKey (32 hex chars) — from your TTN device registration.
# Register the device as LoRaWAN MAC v1.0.3, OTAA, EU868.
CONFIG_TANENBASE_APP_KEY="00000000000000000000000000000000"

# --- ABP (optional) ---------------------------------------------------------
# Activation without a join, for sites where downlinks (and so OTAA joins)
# don't get through. Normally set per node in the setup page (Network tab);
# these only seed a unit whose ZMS holds nothing. See docs/LORAWAN.md §13.
# Register the device in TTN as ABP, LoRaWAN 1.0.3, default MAC settings,
# no factory preset frequencies, "Resets frame counters" off.
# CONFIG_TANENBASE_LORA_ABP=y
# DevAddr (8 hex chars, MSB first as TTN prints it)
# CONFIG_TANENBASE_DEV_ADDR="00000000"
# CONFIG_TANENBASE_NWK_SKEY="00000000000000000000000000000000"
# CONFIG_TANENBASE_APP_SKEY="00000000000000000000000000000000"
